MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=openscout
MYSQL_USER=openscout
MYSQL_PASSWORD=openscout
MYSQL_PORT=3306
REDIS_PORT=6379

OPSCOUT_COLLECTOR_BASE_URL=http://localhost:8081
OPSCOUT_MOCK_AGENT=true
OPSCOUT_COLLECTOR_MODE=mock

# Optional for real GitHub API mode.
GITHUB_TOKEN=<secret>

# Optional for later Spring AI integration through DeepSeek-compatible OpenAI API.
# Keep model providers disabled in mock mode. Set SPRING_AI_MODEL_CHAT=openai
# when enabling the real Spring AI chat model.
SPRING_AI_MODEL_CHAT=none
DEEPSEEK_API_KEY=<secret>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
