# ============================================================
# OpenScout Agent - 环境变量配置示例
# ============================================================
# 复制本文件为 .env 后按需修改。所有值均为占位符，请勿提交真实密钥。
#   cp .env.example .env
# ============================================================

# ---- Docker Compose ----
MYSQL_ROOT_PASSWORD=<your-mysql-root-password>
MYSQL_DATABASE=openscout
MYSQL_USER=openscout
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_PORT=3306
REDIS_PORT=6379

# ---- Java Agent Server ----
SERVER_PORT=8080

# 数据库连接（对应 Docker Compose 默认值）
MYSQL_URL=jdbc:mysql://localhost:3306/openscout?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC

# Flyway 迁移开关（与 OPSCOUT_PERSISTENCE_ENABLED 联动；本地开发默认 false）
FLYWAY_ENABLED=false

# ---- 核心模式开关 ----
# Agent 模式：true=mock（无需模型/外部 API），false=真实 Agent
OPSCOUT_MOCK_AGENT=true
# Collector 模式：mock / real
OPSCOUT_COLLECTOR_MODE=mock
# LLM 开关：true=启用模型调用
OPSCOUT_LLM_ENABLED=true
# 持久化开关：true=启用 MySQL 存储
OPSCOUT_PERSISTENCE_ENABLED=false

# ---- Agent 行为 ----
OPSCOUT_MEMORY_ENABLED=true
OPSCOUT_REACT_ENABLED=true
OPSCOUT_VERIFIER_ENABLED=true
OPSCOUT_VERIFIER_LLM_ENABLED=false
OPSCOUT_EVENTS_ENABLED=true
OPSCOUT_LEARNING_ENABLED=true

# ---- 外部 API ----
# Go Collector 地址
OPSCOUT_COLLECTOR_BASE_URL=http://localhost:8081
# Go Collector 端口
PORT=8081

# GitHub Token（真实模式必需；mock 模式不需要）
GITHUB_TOKEN=<your-github-token>

# DeepSeek / OpenAI 兼容模型
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# LLM 参数
OPSCOUT_LLM_TIMEOUT_SECONDS=30
OPSCOUT_LLM_MAX_TOKENS=2000
OPSCOUT_LLM_TEMPERATURE=0.7

# ---- Security (默认关闭，本地 Demo 不需要) ----
OPSCOUT_SECURITY_ENABLED=false
OPSCOUT_API_KEY=<your-api-key>
OPSCOUT_API_KEY_HEADER=X-OpenScout-Api-Key

# Go Collector 可选 API Key（空=关闭）
OPSCOUT_COLLECTOR_API_KEY=

# ---- Quota (默认关闭，本地 Demo 不需要) ----
OPSCOUT_QUOTA_ENABLED=false
OPSCOUT_QUOTA_MAX_REQUESTS=30
OPSCOUT_QUOTA_WINDOW_SECONDS=60

# ---- Go Collector 内部参数 ----
OPSCOUT_RATE_LIMIT_RPS=2
OPSCOUT_RATE_LIMIT_BURST=4
OPSCOUT_CACHE_TTL_MINUTES=10
OPSCOUT_WORKER_CONCURRENCY=4
OPSCOUT_HTTP_TIMEOUT_SECONDS=8

# ---- Agent Events ----
OPSCOUT_EVENTS_SSE_TIMEOUT_SECONDS=300
OPSCOUT_EVENTS_BUFFER_SIZE=200
OPSCOUT_EVENTS_MAX_ACTIVE_RUNS=20
OPSCOUT_EVENTS_EXECUTOR_THREADS=4
OPSCOUT_EVENTS_HEARTBEAT_SECONDS=15
OPSCOUT_EVENTS_COMPLETED_RETENTION_SECONDS=300

# ---- Trace ----
OPSCOUT_TRACE_MAX_SUMMARY_LENGTH=800
